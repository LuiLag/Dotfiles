{
    // --- POSICIÓN Y TAMAÑO DE LA BARRA ---
    "layer": "top",
    "position": "top",
    "margin-top": 10,
    "margin-left": 16,
    "margin-right": 16,
    "spacing": 8,

    // --- DISTRIBUCIÓN DE MÓDULOS ---
    "modules-left": [
        "custom/launcher",
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "pulseaudio",
        "network",
        "custom/power"
    ],

    // --- DETALLE DE CADA MÓDULO ---
    "custom/launcher": {
        "format": "\uf6be",             // Código Unicode seguro para el icono de Gato (FontAwesome)
        "tooltip-format": "Abrir aplicaciones",
        "on-click": "rofi -show drun"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "active": "\uf111",         // Círculo relleno
            "default": "\uf10c"         // Círculo vacío
        }
    },

    "hyprland/window": {
        "max-length": 35,
        "separate-outputs": true
    },

    "clock": {
        "format": "\uf017  {:%H:%M  •  %a %d %b}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "\uf2db  {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "\uf538  {percentage}%",
        "interval": 2
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "\uf6a9  Mute",
        "format-icons": {
            "default": ["\uf026", "\uf027", "\uf028"]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format": "\uf796  Conectado",             // Código Unicode seguro para cable Ethernet
        "format-wifi": "\uf1eb  {essid}",          // Icono Wi-Fi
        "format-ethernet": "\uf796  Ethernet",     // Icono cable Ethernet
        "format-linked": "\uf796  {ifname}",
        "format-disconnected": "\uf127  Sin red",  // Icono desconectado
        "format-alt": "\uf0ac  {ipaddr}",          // Clic para ver tu IP
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "custom/power": {
        "format": "\uf011",
        "tooltip": false,
        "on-click": "hyprctl dispatch exit"
    }
}
