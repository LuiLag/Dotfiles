{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "left",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",
  "control-center-margin-top": 8,
  "control-center-margin-bottom": 8,
  "control-center-margin-left": 12,
  "control-center-margin-right": 0,
  "notification-2fa-action": true,
  "notification-inline-replies": false,
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 370,
  "notification-window-width": 380,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,
  "script-fail-notify": true,
  "widgets": [
    "label",
    "title",
    "buttons-grid",
    "mpris"
  ],
  "widget-config": {
    "title": {
      "text": "⠀            10°C Parcialmente nublado",
      "clear-all-button": false
    },
    "dnd": {
      "text": "No molestar"
    },
    "volume": {
      "label": " ",
      "show-per-app": false
    },
    "mpris": {
      "image-size": 64,
      "image-radius": 14,
      "blur": false
    },
    "buttons-grid": {
      "buttons-per-row": 4,
      "actions": [
        {
          "label": "",
          "type": "normal",
          "command": "/home/lu/.local/bin/centro-completo.sh && /home/lu/.local/bin/menu-bluetooth.sh"
        },
        {
          "label": "",
          "type": "normal",
          "command": "/home/lu/.local/bin/centro-completo.sh && /home/lu/.local/bin/menu-audio.sh"
        },
        {
          "label": "",
          "type": "normal",
          "command": "/home/lu/.local/bin/toggle-noche.sh"
        },
        {
          "label": "",
          "type": "normal",
          "command": "/home/lu/.local/bin/toggle-gamemode.sh"
        },
        {
          "label": "",
          "type": "normal",
          "command": "/home/lu/.local/bin/centro-completo.sh && sleep 0.3 && COLOR=$(hyprpicker -a) && [ -n \"$COLOR\" ] && notify-send \"Color Copiado\" \"$COLOR guardado en el portapapeles\""
        },
        {
          "label": "",
          "type": "normal",
          "command": "/home/lu/.local/bin/centro-completo.sh && /home/lu/.local/bin/cambiar-fondo.sh"
        },
        {
          "label": "",
          "type": "normal",
          "command": "/home/lu/.local/bin/centro-completo.sh && hyprlock"
        },
        {
          "label": "",
          "type": "normal",
          "command": "/home/lu/.local/bin/centro-completo.sh && /home/lu/.local/bin/menu-energia.sh"
        }
      ]
    },
    "label": {
      "max-lines": 10,
      "text": "       LuiLag • Up 22h 27m\n         Mérida, Yucatán\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n            05:54 PM\n     Jueves, 26 de noviembre\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nCDMX:  05:54 PM  Tokio: 08:54 AM\nMadrid:12:54 AM  Seúl:  08:54 AM"
    }
  }
}