{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "left",
  "positionY": "center",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "cssPriority": "user",

  "control-center-margin-left": 20,
  "control-center-width": 380,
  "control-center-height": 580,
  "fit-to-screen": false,

  "notification-window-width": 350,
  "timeout": 3,
  "timeout-low": 3,
  "timeout-critical": 3,

  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": false,
  "hide-on-action": true,

  "widgets": [
    "title",
    "dnd",
    "mpris",
    "volume",
    "buttons-grid",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Centro de Control",
      "clear-all-button": true,
      "button-text": "Limpiar"
    },
    "dnd": {
      "text": "No molestar"
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 14
    },
    "volume": {
      "label": " "
    },
    "buttons-grid": {
      "actions": [
        {
          "label": "  Red",
          "command": "kitty -e nmtui"
        },
        {
          "label": "  Audio",
          "command": "pavucontrol"
        },
        {
          "label": "  Fondo",
          "command": "/home/lu/.local/bin/cambiar-fondo.sh"
        },
        {
          "label": "  Bloquear",
          "command": "hyprlock"
        }
      ]
    }
  }
}
