# ============================================================================
# CONFIGURACIÓN DE NOTIFICACIONES MAKO (CATPPUCCIN MOCHA - 3 SEGUNDOS)
# ============================================================================

# --- FUENTE Y POSICIÓN ---
font=JetBrainsMono Nerd Font 10
anchor=top-right
margin=16,16,0,0
padding=14
width=340
height=120

# --- DISEÑO Y COLORES ---
background-color=#1E1E2EE6
text-color=#CDD6F4
border-color=#CBA6F7
border-size=2
border-radius=16
progress-color=over #313244

# --- COMPORTAMIENTO Y TIEMPO DE CIERRE ---
default-timeout=3000
ignore-timeout=1
icons=1
max-icon-size=48
layer=overlay

# --- NOTIFICACIONES URGENTES ---
[urgency=high]
border-color=#F38BA8
default-timeout=3000
