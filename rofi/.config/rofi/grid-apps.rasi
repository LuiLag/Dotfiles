@import "/home/lu/.config/rofi/config.rasi"

configuration {
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

window {
    width: 620px;
    border-radius: 28px;
    padding: 20px;
}

mainbox {
    spacing: 14px;
    children: [ inputbar, listview ];
}

inputbar {
    border-radius: 18px;
    padding: 12px 16px;
}

entry {
    placeholder: "Buscar aplicación...";
}

listview {
    columns: 5;
    lines: 3;
    spacing: 12px;
    fixed-height: true;
    fixed-columns: true;
}

element {
    orientation: vertical;
    padding: 14px 8px;
    spacing: 8px;
    border-radius: 20px;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 52px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

/* --- OCULTA EL TEXTO EN APPS NO SELECCIONADAS Y LO MUESTRA AL PASAR EL MOUSE --- */
element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "JetBrainsMono Nerd Font Bold 10";
    text-color: transparent;
}

element-text selected.normal {
    text-color: @fg;
}
