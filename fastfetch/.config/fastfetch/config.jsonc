{
    "$schema": "https://github.com",
    "logo": {
        "type" : "file",
	"source": "~/.config/fastfetch/gato.txt",
        "color": {
            "1": "#CBA6F7"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " ➔ ",
        "color": {
            "keys": "#CBA6F7",
            "title": "#F5C2E7"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "  {user-name}@{host-name}"
        },
        {
            "type": "custom",
            "format": "╭───────────────   ENTORNO ───────────────╮"
        },
        {
            "type": "os",
            "key": "│  OS",
            "keyColor": "#89B4FA"
        },
        {
            "type": "kernel",
            "key": "│  Kernel",
            "keyColor": "#89B4FA"
        },
        {
            "type": "wm",
            "key": "│  WM",
            "keyColor": "#89B4FA"
        },
        {
            "type": "terminal",
            "key": "│  Term",
            "keyColor": "#89B4FA"
        },
        {
            "type": "shell",
            "key": "│  Shell",
            "keyColor": "#89B4FA"
        },
        {
            "type": "custom",
            "format": "├───────────────   HARDWARE ──────────────┤"
        },
        {
            "type": "cpu",
            "key": "│  CPU",
            "keyColor": "#A6E3A1"
        },
        {
            "type": "gpu",
            "key": "│    GPU",
            "keyColor": "#A6E3A1"
        },
        {
            "type": "memory",
            "key": "│  RAM",
            "keyColor": "#A6E3A1"
        },
        {
            "type": "disk",
            "key": "│    Disco",
            "keyColor": "#A6E3A1"
        },
        {
            "type": "uptime",
            "key": "│    Uptime",
            "keyColor": "#F9E2AF"
        },
        {
            "type": "custom",
            "format": "╰──────────────────────────────────────────╯"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
