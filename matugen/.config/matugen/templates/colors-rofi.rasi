/* Colores dinámicos para Rofi generados por Matugen */
* {
    bg:          {{colors.surface.default.hex}}E6;
    bg-alt:      {{colors.surface_container.default.hex}}CC;
    fg:          {{colors.on_surface.default.hex}};
    accent:      {{colors.primary.default.hex}};
    subtle:      {{colors.secondary.default.hex}};
}
